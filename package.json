{
  "name": "lctrn",
  "version": "0.0.1",
  "description": "Local-filesystem orchestration layer for Claude Code — paper-pile + embedded-terminal spike",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "node scripts/postinstall.js",
    "package": "npm run build && npm run rebuild && electron-builder --mac",
    "build:server": "vite build --config vite.server.config.ts",
    "serve": "npm run build && npm run build:server && node bin/lectern.js",
    "example": "npm run build:server && node out/server/make-example.js"
  },
  "devDependencies": {
    "@electron/rebuild": "latest",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/ws": "^8.18.1",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "@xterm/addon-fit": "latest",
    "@xterm/xterm": "latest",
    "chokidar": "^4.0.3",
    "node-pty": "latest",
    "pdf-lib": "^1.17.1",
    "unpdf": "^1.6.2",
    "ws": "^8.21.3"
  },
  "bin": {
    "lectern": "bin/lectern.js"
  },
  "files": [
    "out/",
    "bin/",
    "scripts/postinstall.js",
    "resources/"
  ]
}
